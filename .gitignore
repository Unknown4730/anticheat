# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
.venv/
venv/
env/
ENV/

# Runtime databases and logs (created automatically at runtime; do not commit)
runtime/
*.db
*.sqlite
*.sqlite3
*.log

# YOLOv8 training run outputs (large; re-generate by re-training)
runs/

# Dataset cache files (auto-generated by YOLOv8)
data/**/*.cache
train/labels.cache
valid/labels.cache
test/labels.cache

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# IDE and editor settings
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Environment variable files
.env
.env.*

# Coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml

# Pytest cache
.pytest_cache/

# mypy / type checkers
.mypy_cache/
