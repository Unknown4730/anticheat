# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
.venv/
venv/
env/
ENV/

# Runtime databases (created automatically at runtime; do not commit)
*.db
*.sqlite
*.sqlite3

# Logs and output directories
logs/
*.log

# YOLOv8 training run outputs (large; re-generate by re-training)
runs/

# Model weights (keep only committed weights, ignore generated ones)
*.pt
!models/yolov8n.pt

# Dataset cache files (auto-generated by YOLOv8)
data/**/*.cache
train/labels.cache
valid/labels.cache
test/labels.cache

# OS files
.DS_Store
Thumbs.db

# Editor / IDE files
.idea/
.vscode/
*.swp
*.swo

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Environment variable files
.env
.env.*

# Coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml

# Pytest cache
.pytest_cache/

# mypy / type checkers
.mypy_cache/
